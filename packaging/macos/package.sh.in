#!/bin/sh
set -eu

source_dir="@CMAKE_CURRENT_SOURCE_DIR@"
build_dir="@CMAKE_CURRENT_BINARY_DIR@"
version="@PROJECT_VERSION@"
package_dir="$build_dir/package/macos"
component_dir="$package_dir/components"
resource_dir="$package_dir/resources"
font_root="$package_dir/font-root"
shortcut_root="$package_dir/shortcut-root"

rm -rf "$package_dir"
mkdir -p "$component_dir" "$resource_dir" "$font_root/Library/Fonts" "$shortcut_root"
cp "$source_dir/LICENSE" "$resource_dir/LICENSE"
cp "$source_dir"/assets/fonts/system/*.ttf "$font_root/Library/Fonts/"
mkdir -p "$build_dir/ParsiNegar.app/Contents/Resources/licenses"
cp "$source_dir/LICENSE" "$build_dir/ParsiNegar.app/Contents/Resources/licenses/"
cp "$source_dir/THIRD_PARTY_NOTICES.md" "$build_dir/ParsiNegar.app/Contents/Resources/licenses/"
cp "$source_dir/SOURCES.md" "$build_dir/ParsiNegar.app/Contents/Resources/licenses/"
cp "$source_dir/packaging/Qt-LGPL-NOTICE.md" "$build_dir/ParsiNegar.app/Contents/Resources/licenses/"
if [ -f "@PARSINEGAR_QT_LGPL3_FILE@" ]; then
    cp "@PARSINEGAR_QT_LGPL3_FILE@" "$build_dir/ParsiNegar.app/Contents/Resources/licenses/Qt-LGPL-3.0-only.txt"
fi

if [ -n "${PARSINEGAR_CODESIGN_IDENTITY:-}" ]; then
    codesign --force --deep --options runtime --timestamp --sign "$PARSINEGAR_CODESIGN_IDENTITY" "$build_dir/ParsiNegar.app"
fi

pkgbuild --component "$build_dir/ParsiNegar.app" --install-location /Applications \
    --identifier com.leomoon.ParsiNegarDesktop.app --version "$version" \
    "$component_dir/ParsiNegar-app.pkg"
pkgbuild --root "$font_root" --identifier com.leomoon.ParsiNegarDesktop.fonts \
    --version "$version" "$component_dir/ParsiNegar-fonts.pkg"
pkgbuild --root "$shortcut_root" --scripts "$source_dir/packaging/macos/shortcut-scripts" \
    --identifier com.leomoon.ParsiNegarDesktop.shortcut --version "$version" \
    "$component_dir/ParsiNegar-shortcut.pkg"

sed "s/@PROJECT_VERSION@/$version/g" "$source_dir/packaging/macos/distribution.xml.in" > "$package_dir/distribution.xml"

if [ -n "${PARSINEGAR_INSTALLER_IDENTITY:-}" ]; then
    productbuild --distribution "$package_dir/distribution.xml" --resources "$resource_dir" \
        --package-path "$component_dir" --sign "$PARSINEGAR_INSTALLER_IDENTITY" \
        "$package_dir/ParsiNegar-Desktop-$version.pkg"
else
    productbuild --distribution "$package_dir/distribution.xml" --resources "$resource_dir" \
        --package-path "$component_dir" "$package_dir/ParsiNegar-Desktop-$version.pkg"
fi

hdiutil create -volname "ParsiNegar Desktop" -srcfolder "$build_dir/ParsiNegar.app" \
    -ov -format UDZO "$package_dir/ParsiNegar-Desktop-$version.dmg"

if [ -n "${PARSINEGAR_NOTARY_PROFILE:-}" ]; then
    xcrun notarytool submit "$package_dir/ParsiNegar-Desktop-$version.pkg" \
        --keychain-profile "$PARSINEGAR_NOTARY_PROFILE" --wait
    xcrun stapler staple "$package_dir/ParsiNegar-Desktop-$version.pkg"
    xcrun notarytool submit "$package_dir/ParsiNegar-Desktop-$version.dmg" \
        --keychain-profile "$PARSINEGAR_NOTARY_PROFILE" --wait
    xcrun stapler staple "$package_dir/ParsiNegar-Desktop-$version.dmg"
fi
