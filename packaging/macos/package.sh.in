#!/bin/sh
set -eu

source_dir="@CMAKE_CURRENT_SOURCE_DIR@"
build_dir="@CMAKE_CURRENT_BINARY_DIR@"
version="@PROJECT_VERSION@"
package_dir="$build_dir/package/macos"
component_dir="$package_dir/components"
resource_dir="$package_dir/resources"
font_root="$package_dir/font-root"

rm -rf "$package_dir"
mkdir -p "$component_dir" "$resource_dir" "$font_root/Library/Fonts"
cp "$source_dir/LICENSE" "$resource_dir/LICENSE"
font_count=0
for font in "$source_dir"/assets/fonts/system/*; do
    [ -f "$font" ] || continue
    case "$font" in
        *.ttf|*.otf|*.ttc)
            cp "$font" "$font_root/Library/Fonts/"
            font_count=$((font_count + 1))
            ;;
    esac
done
if [ "$font_count" -eq 0 ]; then
    echo "No bundled system fonts were found" >&2
    exit 1
fi
mkdir -p "$build_dir/leomoon-parsinegar.app/Contents/Resources/licenses"
cp "$source_dir/LICENSE" "$build_dir/leomoon-parsinegar.app/Contents/Resources/licenses/"
cp "$source_dir/THIRD_PARTY_NOTICES.md" "$build_dir/leomoon-parsinegar.app/Contents/Resources/licenses/"
cp "$source_dir/SOURCES.md" "$build_dir/leomoon-parsinegar.app/Contents/Resources/licenses/"
cp "$source_dir/packaging/Qt-LGPL-NOTICE.md" "$build_dir/leomoon-parsinegar.app/Contents/Resources/licenses/"
if [ -f "@PARSINEGAR_QT_LGPL3_FILE@" ]; then
    cp "@PARSINEGAR_QT_LGPL3_FILE@" "$build_dir/leomoon-parsinegar.app/Contents/Resources/licenses/Qt-LGPL-3.0-only.txt"
fi

if [ -n "${PARSINEGAR_CODESIGN_IDENTITY:-}" ]; then
    codesign --force --deep --options runtime --timestamp --sign "$PARSINEGAR_CODESIGN_IDENTITY" "$build_dir/leomoon-parsinegar.app"
fi

pkgbuild --component "$build_dir/leomoon-parsinegar.app" --install-location /Applications \
    --identifier com.leomoon.ParsiNegar.app --version "$version" \
    "$component_dir/leomoon-parsinegar-app.pkg"
pkgbuild --root "$font_root" --identifier com.leomoon.ParsiNegar.fonts \
    --version "$version" "$component_dir/leomoon-parsinegar-fonts.pkg"
pkgbuild --nopayload --scripts "$source_dir/packaging/macos/shortcut-scripts" \
    --identifier com.leomoon.ParsiNegar.shortcut --version "$version" \
    "$component_dir/leomoon-parsinegar-shortcut.pkg"

sed "s/@PROJECT_VERSION@/$version/g" "$source_dir/packaging/macos/distribution.xml.in" > "$package_dir/distribution.xml"

if [ -n "${PARSINEGAR_INSTALLER_IDENTITY:-}" ]; then
    productbuild --distribution "$package_dir/distribution.xml" --resources "$resource_dir" \
        --package-path "$component_dir" --sign "$PARSINEGAR_INSTALLER_IDENTITY" \
        "$package_dir/leomoon-parsinegar-$version-macos-universal.pkg"
else
    productbuild --distribution "$package_dir/distribution.xml" --resources "$resource_dir" \
        --package-path "$component_dir" "$package_dir/leomoon-parsinegar-$version-macos-universal.pkg"
fi

hdiutil create -volname "LeoMoon ParsiNegar" -srcfolder "$build_dir/leomoon-parsinegar.app" \
    -ov -format UDZO "$package_dir/leomoon-parsinegar-$version-macos-universal.dmg"

if [ -n "${PARSINEGAR_NOTARY_PROFILE:-}" ]; then
    submit_for_notarization() {
        artifact=$1
        if [ -n "${PARSINEGAR_NOTARY_KEYCHAIN:-}" ]; then
            xcrun notarytool submit "$artifact" --keychain-profile "$PARSINEGAR_NOTARY_PROFILE" \
                --keychain "$PARSINEGAR_NOTARY_KEYCHAIN" --wait
        else
            xcrun notarytool submit "$artifact" --keychain-profile "$PARSINEGAR_NOTARY_PROFILE" --wait
        fi
    }
    submit_for_notarization "$package_dir/leomoon-parsinegar-$version-macos-universal.pkg"
    xcrun stapler staple "$package_dir/leomoon-parsinegar-$version-macos-universal.pkg"
    submit_for_notarization "$package_dir/leomoon-parsinegar-$version-macos-universal.dmg"
    xcrun stapler staple "$package_dir/leomoon-parsinegar-$version-macos-universal.dmg"
fi
