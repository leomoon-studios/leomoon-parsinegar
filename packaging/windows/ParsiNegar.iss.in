#define AppName "ParsiNegar Desktop"
#define AppVersion "@PROJECT_VERSION@"
#define AppPublisher "LeoMoon Studios"
#define AppExeName "ParsiNegar.exe"
#define StageDir "@PARSINEGAR_WINDOWS_STAGE_DIR@"
#define SourceDir "@CMAKE_CURRENT_SOURCE_DIR@"

[Setup]
AppId={{A606C8EF-A831-48F2-90D0-A16499853D2E}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppPublisher}
DefaultDirName={autopf}\ParsiNegar Desktop
DefaultGroupName=ParsiNegar Desktop
OutputDir=@CMAKE_CURRENT_BINARY_DIR@\package\windows
OutputBaseFilename=ParsiNegar-Desktop-{#AppVersion}-Setup
SetupIconFile={#SourceDir}\packaging\windows\app-icon.ico
UninstallDisplayIcon={app}\bin\{#AppExeName}
UninstallDisplayName={#AppName}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
PrivilegesRequired=admin
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
LicenseFile={#SourceDir}\LICENSE
VersionInfoCompany={#AppPublisher}
VersionInfoDescription={#AppName} installer
VersionInfoProductName={#AppName}
VersionInfoProductVersion={#AppVersion}
VersionInfoVersion={#AppVersion}

[Tasks]
Name: "systemfonts"; Description: "Install bundled LMN and LMU fonts system-wide"; GroupDescription: "Additional options:"; Flags: checkedonce
Name: "desktopshortcut"; Description: "Create a desktop shortcut"; GroupDescription: "Additional options:"; Flags: checkedonce

[Files]
Source: "{#StageDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
@PARSINEGAR_WINDOWS_FONT_FILE_ENTRIES@

[Icons]
Name: "{group}\ParsiNegar Desktop"; Filename: "{app}\bin\{#AppExeName}"
Name: "{autodesktop}\ParsiNegar Desktop"; Filename: "{app}\bin\{#AppExeName}"; Tasks: desktopshortcut
